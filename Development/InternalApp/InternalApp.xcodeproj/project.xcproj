      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-snapshot-testing",
      "version": {
        "version": "1.19.6",
      },
    },
  ],
  "files": [
    { "path": "AppIcon.icon", "target-membership": [ "SVGUIViewCI/resources" ] },
    { "path": "../../InternalApp.xctestplan" },
    { "path": "Packages/SnapshotAssets" },
    { "kind": "folder", "path": "InternalApp", "target-membership": [ "SVGUIViewCI" ] },
    { "kind": "folder", "path": "InternalAppTests", "target-membership": [ "SVGUIViewCITests" ] },
    { "kind": "folder", "path": "InternalAppUITests", "target-membership": [ "SVGUIViewCIUITests" ] },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SVGUIViewCI.app", "id": "32CD1ACB2F651CA900A86A26", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SVGUIViewCITests.xctest", "id": "32CD1AD82F651CA900A86A26", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/SVGUIViewCIUITests.xctest", "id": "32CD1AE22F651CA900A86A26", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "SVGUIViewCI",
      "id": "32CD1ACA2F651CA900A86A26",
      "product": "Products/SVGUIViewCI.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
